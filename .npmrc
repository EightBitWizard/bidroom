# eslint-config-next references its plugin dependencies (react-hooks, jsx-a11y, import,
# @next/eslint-plugin-next) by name, and the ESLint flat config resolves them from the
# repo root. Public-hoist the eslint packages so that resolution works deterministically
# under pnpm, including on a fresh CI install.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@next/eslint-plugin-next
