# Bidroom server environment - NAMES ONLY, never commit real values.
# Cloudflare secrets are set with `wrangler secret put <NAME>`; local dev uses .dev.vars.
# The backend activates when the DB binding and a sufficiently long SESSION_SECRET are
# present (auth is the product from day one); it returns a clean 503 otherwise.

# HMAC key for session cookies. At least 32 characters. Rotating it (or bumping an account's
# session_version) revokes sessions; see docs/security.md (ADR 0003).
SESSION_SECRET=

# Absolute origin used to build magic links (never derived from request headers).
APP_BASE_URL=https://app.bidroom.example

# Log magic links to the console - LOCAL DEV ONLY, never in production.
DEV_EMAIL_CONSOLE=false

# LLM and OCR (used from WP-014/WP-016, not in Phase 0). Only extraction text is sent;
# never account PII (ADR 0003). Set a daily spend cap.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_EXTRACT=claude-sonnet-4-6
ANTHROPIC_MODEL_TRIAGE=claude-haiku-4-5
LLM_DAILY_SPEND_CAP_USD=25
MISTRAL_API_KEY=

# Email (used from WP-004 for magic links once a provider is wired).
RESEND_API_KEY=
EMAIL_FROM=notifications@bidroom.example

# Stripe (Phase 2; hosted Checkout + Portal only; webhook signatures verified).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Analytics (marketing site).
PLAUSIBLE_DOMAIN=

# Local default: never call live LLM/OCR APIs in tests.
LLM_USE_FIXTURES=true

# Bindings live in wrangler.jsonc, not env vars: DB (D1, jurisdiction=eu),
# DOCS (R2, jurisdiction=eu), RATE_LIMIT_KV (durable auth rate limiter, ADR 0003).
